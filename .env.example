# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required for connectors (stores/reads encrypted credentials, OAuth state, rate limits). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (at least one, or chat shows a "not set up" state) ---
NVIDIA_API_KEY=
# Optional comma-separated model list
NVIDIA_MODELS=
OPENROUTER_API_KEY=
# Optional comma-separated model list
OPENROUTER_MODEL=
# Optional: which of the models above can read images (comma list of "provider:model" or model ids,
# e.g. openrouter:nvidia/nemotron-3.5-super-vl:free). When unset, names like "-vl", "vision", "llava",
# "pixtral" are treated as vision models. With none, image attachments get a polite "can't see images" reply.
VISION_MODELS=

# --- Web search (optional) ---
TAVILY_API_KEY=

# --- Connectors: credential encryption (required for any connector) ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
CONNECTOR_ENCRYPTION_KEY=
# Legacy name from the earlier Google Calendar integration. Still read: used for encryption when
# CONNECTOR_ENCRYPTION_KEY is unset, and tried for decryption when both are set. Can be removed once
# every connection has been re-saved with CONNECTOR_ENCRYPTION_KEY.
TOKEN_ENCRYPTION_KEY=

# --- Supabase connector (optional OAuth; without these users paste a personal access token) ---
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# --- Vercel connector: no server variables (users paste a Vercel access token) ---

# --- GitHub connector (OAuth App) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Google connector (Gmail, Calendar, Drive) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Figma connector: no server variables (users paste a Figma personal access token) ---

# --- Canva connector (Canva Developer Portal app) ---
CANVA_OAUTH_CLIENT_ID=
CANVA_OAUTH_CLIENT_SECRET=

# --- Slack connector (Slack app) ---
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=

# --- Notion connector (Notion public connection) ---
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# --- Scheduled prompts (Vercel Cron) ---
# Required for /api/cron/scheduled. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# At least 16 characters. Generate with: openssl rand -hex 32
# Scheduled runs also need SUPABASE_SERVICE_ROLE_KEY (above).
CRON_SECRET=

# --- Phone notifications (PWA web push) ---
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# --- Error alerts ---
# Your sign-in email. Site errors are pushed to this account's phone (turn on notifications in Settings).
ADMIN_EMAIL=

# Optional: trusted session worker (headless browser that signs in or registers on websites for users).
# It calls /api/site-sessions/worker with "Authorization: Bearer <SESSION_WORKER_SECRET>". 32+ random characters
# (openssl rand -hex 32). Leave empty to keep the endpoint closed.
SESSION_WORKER_SECRET=

# The same SESSION_WORKER_SECRET also lets worker/browser-worker.mjs (run outside Vercel) pick up approved browser tasks.

# --- Reminders ---
# Add CRON_SECRET (same value) as a GitHub repo Actions secret so .github/workflows/scheduled-prompts.yml
# can run due reminders every 10 minutes.
