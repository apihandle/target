# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed only for connected apps (stores encrypted OAuth tokens). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (at least one, or chat shows a "not set up" state) ---
NVIDIA_API_KEY=
# Optional comma-separated model list
NVIDIA_MODELS=
OPENROUTER_API_KEY=
# Optional comma-separated model list
OPENROUTER_MODEL=

# --- Web search (optional) ---
TAVILY_API_KEY=

# --- Google Calendar connection (optional; all four plus SUPABASE_SERVICE_ROLE_KEY) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
