{
  "name": "TARGET",
  "short_name": "TARGET",
  "description": "Your personal AI workspace: chat, projects, tasks and approvals.",
  "id": "/app",
  "start_url": "/app/home",
  "scope": "/app",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c0d10",
  "theme_color": "#0c0d10",
  "icons": [
    { "src": "/app-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/logo-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New chat", "url": "/app", "icons": [{ "src": "/app-icon-192.png", "sizes": "192x192" }] },
    { "name": "Activity", "url": "/app/activity", "icons": [{ "src": "/app-icon-192.png", "sizes": "192x192" }] }
  ]
}
